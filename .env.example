# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO — POS PALETERÍA v2
# Copia este archivo a .env.local para desarrollo local
# ==============================================================================

# Modo de Aplicación: LOCAL | DEV | PROD
# - LOCAL: Desarrollo sin red con MockDataAdapter y consola informativa
# - DEV: Pruebas con Apps Script en entorno de prueba y logs detallados
# - PROD: Producción en Netlify conectada a Google Sheets real
VITE_APP_MODE=LOCAL

# Adaptador de Persistencia de Datos: mock | sheets
# - mock: Almacenamiento 100% en memoria/local (Fases 1 a 4)
# - sheets: Conexión HTTP vía Google Apps Script (Fase 5 en adelante)
VITE_DATA_ADAPTER=mock

# Soporte de Métodos de Pago: true | false
# Por defecto solo Efectivo (R15). Al activar true, habilita transferencias.
VITE_ENABLE_TRANSFERENCIAS=false

# URL del Web App de Google Apps Script (requerido únicamente si VITE_DATA_ADAPTER=sheets)
# Ejemplo: https://script.google.com/macros/s/AKfycbx.../exec
VITE_SHEETS_WEBAPP_URL=

# Metadatos del Sistema
VITE_APP_TITLE=POS Paletería v2
VITE_APP_VERSION=2.0.0
